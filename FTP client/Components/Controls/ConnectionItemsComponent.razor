<style>
    .selected 
    {
        background-color: @Colors.DeepPurple.Lighten1 !important;
    }

    .selected > td 
    {
        color: white !important;
    }

    .selected > td .mud-input 
    {
        color: white !important;
    }
</style>

<MudTable 
    @bind-SelectedItem="_selectedItem"
    Breakpoint="Breakpoint.None"
    Hover="true"
    Items="_items" 
    Loading="_isLoading"
    PagerPosition="PagerPosition.Bottom"
    RowClassFunc="@SelectedRowClassFunc"
>
    <ToolBarContent>
        <ItemsManagingButtonsComponent 
            FTPClient="FTPClient"
            OnItemsChangeEventCallback="GetItemsAsync"
            @ref="_itemsManagingButtonsComponent"
            SelectedItem="_selectedItem"
        />
    </ToolBarContent>

    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<FtpListItem, object>(x => x.Name)">Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<FtpListItem, object>(x => x.Size)">Size</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<FtpListItem, object>(x => x.Modified)">Last modified</MudTableSortLabel></MudTh>
    </HeaderContent>

    <RowTemplate>
        @if(context.Type == FluentFTP.FtpObjectType.Directory)
            {
                <MudTd>
                    <MudIconButton
                        Icon="@Icons.Material.Filled.FolderOpen"
                        OnClick="(() => ChangeWorkingDirectory(context))"
                    />
                    <text> @context.Name</text>
                </MudTd>
                <MudTd>...</MudTd>
            }
            else
            {
                <MudTd>
                    <MudIconButton 
                        Disabled="true" 
                        Icon="@ItemIconConverter.Convert(context.Type)"
                    />
                    <text> @context.Name</text>
                </MudTd>
                <MudTd>@ByteSizeConverter.Convert(context.Size)</MudTd>
            }
        <MudTd>@context.Modified.ToString("dd.MM.yyyy HH:mm:ss")</MudTd>
    </RowTemplate>

    <PagerContent>
        <MudTablePager/>
    </PagerContent>
</MudTable>