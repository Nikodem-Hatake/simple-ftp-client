@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="_isDarkMode"/>
<MudPopoverProvider/>
<MudSnackbarProvider/>

<MudLayout class="mt-10">
    <MudAppBar>
        <MudSwitch 
            @bind-Value="_isDarkMode"
            Size="Size.Large"
            ThumbIcon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
        />
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>