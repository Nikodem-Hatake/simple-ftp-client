@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="_isDarkMode"/>
<MudPopoverProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar>
        <MudSwitch 
            @bind-Value="_isDarkMode"
            Size="Size.Large"
            ThumbIcon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
        />
    </MudAppBar>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>