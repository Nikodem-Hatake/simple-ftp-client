@page "/"

<MudGrid>
    <MudItem
        xs="12"
        lg="4"
    >
        <ConnectionFormComponent
            FTPClient="_ftpClient"
            OnSuccessfullConnectionEventCallback="GetItemsAsync"
        />
    </MudItem>
    <MudItem
        xs="12"
        lg="8"
    >
        <ConnectionItemsComponent
            FTPClient="_ftpClient"
            @ref="ConnectionItemsComponent"
        />
        <FilesUploadComponent 
            FTPClient="_ftpClient"
            OnUploadedEventCallback="GetItemsAsync"
        />
    </MudItem>
</MudGrid>